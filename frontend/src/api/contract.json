{
  "$id": "urn:business-issue:contract",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AnalysisInput": {
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 10000,
          "minLength": 4,
          "title": "Text",
          "description": "问题及补充背景"
        },
        "business": {
          "type": "string",
          "enum": [
            "订单售后",
            "营销活动",
            "系统支持"
          ],
          "title": "Business",
          "description": "本次分析所属业务"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Id",
          "description": "本人提交的原始材料编号，可省略"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "text",
        "business"
      ],
      "title": "AnalysisInput",
      "description": "HTTP 分析输入，应用层仅接收转换后的业务命令。"
    },
    "AnalysisRead": {
      "properties": {
        "question": {
          "$ref": "#/$defs/QuestionRead"
        },
        "run": {
          "$ref": "#/$defs/RunRead"
        },
        "feedback": {
          "items": {
            "$ref": "#/$defs/FeedbackRead"
          },
          "type": "array",
          "title": "Feedback",
          "description": "新增分析时为空，详情附带历史反馈"
        }
      },
      "type": "object",
      "required": [
        "question",
        "run"
      ],
      "title": "AnalysisRead",
      "description": "提问与运行结果组合，历史详情可追加反馈记录。"
    },
    "AnalysisResult": {
      "properties": {
        "summary": {
          "type": "string",
          "title": "Summary"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "title": "Steps"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "title": "Missing"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/CitationRead"
          },
          "type": "array",
          "title": "Citations"
        },
        "reply": {
          "type": "string",
          "title": "Reply"
        },
        "mode": {
          "type": "string",
          "enum": [
            "model",
            "local_rules"
          ],
          "title": "Mode"
        },
        "notice": {
          "type": "string",
          "title": "Notice"
        }
      },
      "type": "object",
      "required": [
        "summary",
        "steps",
        "missing",
        "citations",
        "reply",
        "mode",
        "notice"
      ],
      "title": "AnalysisResult",
      "description": "持久化分析结果，引用仅来自后台授权检索。"
    },
    "Body_createSource": {
      "properties": {
        "business": {
          "type": "string",
          "enum": [
            "订单售后",
            "营销活动",
            "系统支持"
          ],
          "title": "Business"
        },
        "text": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1,
          "title": "Text"
        },
        "file": {
          "anyOf": [
            {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            {
              "type": "null"
            }
          ],
          "title": "File"
        }
      },
      "type": "object",
      "required": [
        "business",
        "text"
      ],
      "title": "Body_createSource"
    },
    "CaseList": {
      "items": {
        "$ref": "#/$defs/CaseRead"
      },
      "type": "array",
      "title": "CaseList",
      "description": "保持既有列表数组响应，前端使用同名根 Schema 进行校验。"
    },
    "CaseRead": {
      "properties": {
        "id": {
          "type": "string",
          "title": "Id"
        },
        "title": {
          "type": "string",
          "title": "Title"
        },
        "business": {
          "type": "string",
          "enum": [
            "订单售后",
            "营销活动",
            "系统支持"
          ],
          "title": "Business"
        },
        "symptom": {
          "type": "string",
          "title": "Symptom"
        },
        "conditions": {
          "type": "string",
          "title": "Conditions"
        },
        "investigation": {
          "type": "string",
          "title": "Investigation"
        },
        "cause": {
          "type": "string",
          "title": "Cause"
        },
        "solution": {
          "type": "string",
          "title": "Solution"
        },
        "verification": {
          "type": "string",
          "title": "Verification"
        },
        "verified_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Verified By"
        },
        "publication": {
          "type": "string",
          "enum": [
            "draft",
            "pending",
            "published",
            "archived"
          ],
          "title": "Publication"
        },
        "validity": {
          "type": "string",
          "enum": [
            "unverified",
            "verified",
            "invalid"
          ],
          "title": "Validity"
        },
        "source_id": {
          "type": "string",
          "title": "Source Id"
        },
        "owner_id": {
          "type": "string",
          "title": "Owner Id"
        },
        "version": {
          "type": "integer",
          "title": "Version"
        },
        "created_at": {
          "type": "string",
          "title": "Created At",
          "description": "UTC 时区的 ISO 8601 时间"
        },
        "updated_at": {
          "type": "string",
          "title": "Updated At",
          "description": "UTC 时区的 ISO 8601 时间"
        },
        "rule_version": {
          "type": "string",
          "title": "Rule Version",
          "description": "旧快照省略时表示手动录入",
          "default": "manual-v1"
        },
        "is_demo": {
          "type": "boolean",
          "title": "Is Demo"
        }
      },
      "type": "object",
      "required": [
        "id",
        "title",
        "business",
        "symptom",
        "conditions",
        "investigation",
        "cause",
        "solution",
        "verification",
        "verified_by",
        "publication",
        "validity",
        "source_id",
        "owner_id",
        "version",
        "created_at",
        "updated_at",
        "is_demo"
      ],
      "title": "CaseRead",
      "description": "案例事实与状态，历史记录缺少规则版本时保留手动录入语义。"
    },
    "CaseUpdate": {
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 160,
          "minLength": 2,
          "title": "Title",
          "description": "概括问题的案例标题"
        },
        "symptom": {
          "type": "string",
          "maxLength": 10000,
          "minLength": 2,
          "title": "Symptom",
          "description": "原始问题现象"
        },
        "conditions": {
          "type": "string",
          "maxLength": 10000,
          "title": "Conditions",
          "description": "系统、渠道、版本及时间前提",
          "default": ""
        },
        "investigation": {
          "type": "string",
          "maxLength": 10000,
          "title": "Investigation",
          "description": "尝试操作及其观察结果",
          "default": ""
        },
        "cause": {
          "type": "string",
          "maxLength": 10000,
          "title": "Cause",
          "description": "原因说明，未确认时留空",
          "default": ""
        },
        "solution": {
          "type": "string",
          "maxLength": 10000,
          "title": "Solution",
          "description": "实际处理步骤及执行角色",
          "default": ""
        },
        "verification": {
          "type": "string",
          "maxLength": 10000,
          "title": "Verification",
          "description": "验证人、验证条件及实际结果",
          "default": ""
        },
        "publication": {
          "type": "string",
          "enum": [
            "draft",
            "pending",
            "published",
            "archived"
          ],
          "title": "Publication",
          "description": "发布状态，与方案是否有效相互独立"
        },
        "validity": {
          "type": "string",
          "enum": [
            "unverified",
            "verified",
            "invalid"
          ],
          "title": "Validity",
          "description": "方案有效性，已验证时必须保存验证依据"
        },
        "version": {
          "type": "integer",
          "minimum": 1.0,
          "title": "Version",
          "description": "编辑开始时读取的案例版本"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "title",
        "symptom",
        "publication",
        "validity",
        "version"
      ],
      "title": "CaseUpdate",
      "description": "携带预期版本的完整编辑请求，旧版本不得覆盖并发修改。"
    },
    "CitationRead": {
      "properties": {
        "id": {
          "type": "string",
          "title": "Id"
        },
        "title": {
          "type": "string",
          "title": "Title"
        },
        "business": {
          "type": "string",
          "enum": [
            "订单售后",
            "营销活动",
            "系统支持"
          ],
          "title": "Business"
        },
        "symptom": {
          "type": "string",
          "title": "Symptom"
        },
        "conditions": {
          "type": "string",
          "title": "Conditions"
        },
        "investigation": {
          "type": "string",
          "title": "Investigation"
        },
        "cause": {
          "type": "string",
          "title": "Cause"
        },
        "solution": {
          "type": "string",
          "title": "Solution"
        },
        "verification": {
          "type": "string",
          "title": "Verification"
        },
        "verified_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Verified By"
        },
        "publication": {
          "type": "string",
          "enum": [
            "draft",
            "pending",
            "published",
            "archived"
          ],
          "title": "Publication"
        },
        "validity": {
          "type": "string",
          "enum": [
            "unverified",
            "verified",
            "invalid"
          ],
          "title": "Validity"
        },
        "source_id": {
          "type": "string",
          "title": "Source Id"
        },
        "owner_id": {
          "type": "string",
          "title": "Owner Id"
        },
        "version": {
          "type": "integer",
          "title": "Version"
        },
        "created_at": {
          "type": "string",
          "title": "Created At",
          "description": "UTC 时区的 ISO 8601 时间"
        },
        "updated_at": {
          "type": "string",
          "title": "Updated At",
          "description": "UTC 时区的 ISO 8601 时间"
        },
        "rule_version": {
          "type": "string",
          "title": "Rule Version",
          "description": "旧快照省略时表示手动录入",
          "default": "manual-v1"
        },
        "is_demo": {
          "type": "boolean",
          "title": "Is Demo"
        },
        "source_version": {
          "type": "integer",
          "title": "Source Version",
          "description": "分析时读取的原始材料版本"
        },
        "currently_available": {
          "type": "boolean",
          "title": "Currently Available",
          "description": "当前权限、状态和版本均一致时为真",
          "default": true
        }
      },
      "type": "object",
      "required": [
        "id",
        "title",
        "business",
        "symptom",
        "conditions",
        "investigation",
        "cause",
        "solution",
        "verification",
        "verified_by",
        "publication",
        "validity",
        "source_id",
        "owner_id",
        "version",
        "created_at",
        "updated_at",
        "is_demo",
        "source_version"
      ],
      "title": "CitationRead",
      "description": "本次分析引用的案例快照，并标记当前版本是否仍可使用。"
    },
    "DraftInput": {
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 160,
          "minLength": 2,
          "title": "Title",
          "description": "概括问题的案例标题"
        },
        "symptom": {
          "type": "string",
          "maxLength": 10000,
          "minLength": 2,
          "title": "Symptom",
          "description": "原始问题现象"
        },
        "conditions": {
          "type": "string",
          "maxLength": 10000,
          "title": "Conditions",
          "description": "系统、渠道、版本及时间前提",
          "default": ""
        },
        "investigation": {
          "type": "string",
          "maxLength": 10000,
          "title": "Investigation",
          "description": "尝试操作及其观察结果",
          "default": ""
        },
        "cause": {
          "type": "string",
          "maxLength": 10000,
          "title": "Cause",
          "description": "原因说明，未确认时留空",
          "default": ""
        },
        "solution": {
          "type": "string",
          "maxLength": 10000,
          "title": "Solution",
          "description": "实际处理步骤及执行角色",
          "default": ""
        },
        "verification": {
          "type": "string",
          "maxLength": 10000,
          "title": "Verification",
          "description": "验证人、验证条件及实际结果",
          "default": ""
        },
        "source_id": {
          "type": "string",
          "title": "Source Id",
          "description": "原始材料稳定编号"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "title",
        "symptom",
        "source_id"
      ],
      "title": "DraftInput",
      "description": "将案例事实绑定到本人已提交的原始材料。"
    },
    "DraftPreview": {
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 160,
          "minLength": 2,
          "title": "Title",
          "description": "概括问题的案例标题"
        },
        "symptom": {
          "type": "string",
          "maxLength": 10000,
          "minLength": 2,
          "title": "Symptom",
          "description": "原始问题现象"
        },
        "conditions": {
          "type": "string",
          "maxLength": 10000,
          "title": "Conditions",
          "description": "系统、渠道、版本及时间前提",
          "default": ""
        },
        "investigation": {
          "type": "string",
          "maxLength": 10000,
          "title": "Investigation",
          "description": "尝试操作及其观察结果",
          "default": ""
        },
        "cause": {
          "type": "string",
          "maxLength": 10000,
          "title": "Cause",
          "description": "原因说明，未确认时留空",
          "default": ""
        },
        "solution": {
          "type": "string",
          "maxLength": 10000,
          "title": "Solution",
          "description": "实际处理步骤及执行角色",
          "default": ""
        },
        "verification": {
          "type": "string",
          "maxLength": 10000,
          "title": "Verification",
          "description": "验证人、验证条件及实际结果",
          "default": ""
        },
        "rule_version": {
          "type": "string",
          "title": "Rule Version"
        },
        "mode": {
          "type": "string",
          "enum": [
            "model",
            "local_rules"
          ],
          "title": "Mode"
        },
        "similar": {
          "items": {
            "$ref": "#/$defs/CaseRead"
          },
          "type": "array",
          "title": "Similar"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "title",
        "symptom",
        "rule_version",
        "mode",
        "similar"
      ],
      "title": "DraftPreview",
      "description": "草稿预览未写入案例，也不代表方案已经验证。"
    },
    "ErrorRead": {
      "properties": {
        "code": {
          "type": "string",
          "title": "Code"
        },
        "message": {
          "type": "string",
          "title": "Message"
        },
        "detail": {
          "type": "string",
          "title": "Detail"
        },
        "request_id": {
          "type": "string",
          "title": "Request Id"
        }
      },
      "type": "object",
      "required": [
        "code",
        "message",
        "detail",
        "request_id"
      ],
      "title": "ErrorRead",
      "description": "稳定错误契约，detail 保留旧客户端的可展示消息。"
    },
    "FeedbackInput": {
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "resolved",
            "unresolved",
            "not_applicable"
          ],
          "title": "Outcome",
          "description": "本次问题的处理结果"
        },
        "note": {
          "type": "string",
          "maxLength": 5000,
          "minLength": 2,
          "title": "Note",
          "description": "实际操作、观察结果和确认情况"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "outcome",
        "note"
      ],
      "title": "FeedbackInput",
      "description": "HTTP 反馈输入，实际结果不会自动改变案例验证状态。"
    },
    "FeedbackRead": {
      "properties": {
        "id": {
          "type": "string",
          "title": "Id"
        },
        "question_id": {
          "type": "string",
          "title": "Question Id"
        },
        "author_id": {
          "type": "string",
          "title": "Author Id"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "resolved",
            "unresolved",
            "not_applicable"
          ],
          "title": "Outcome"
        },
        "note": {
          "type": "string",
          "title": "Note"
        },
        "created_at": {
          "type": "string",
          "title": "Created At"
        }
      },
      "type": "object",
      "required": [
        "id",
        "question_id",
        "author_id",
        "outcome",
        "note",
        "created_at"
      ],
      "title": "FeedbackRead",
      "description": "追加式实际反馈，重复请求只保留一次已提交结果。"
    },
    "HealthRead": {
      "properties": {
        "status": {
          "type": "string",
          "title": "Status"
        },
        "analysis_mode": {
          "type": "string",
          "enum": [
            "model",
            "local_rules"
          ],
          "title": "Analysis Mode"
        }
      },
      "type": "object",
      "required": [
        "status",
        "analysis_mode"
      ],
      "title": "HealthRead",
      "description": "服务与数据库健康状态，不包含部署细节。"
    },
    "LoginInput": {
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 255,
          "minLength": 3,
          "title": "Email",
          "description": "登录邮箱"
        },
        "password": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1,
          "title": "Password",
          "description": "原始口令，只在认证时使用"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "email",
        "password"
      ],
      "title": "LoginInput",
      "description": "验证登录凭证长度，口令保留原始空白语义。"
    },
    "ModelActivationInput": {
      "properties": {
        "profile_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 36,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "title": "Profile Id"
        },
        "version": {
          "type": "integer",
          "minimum": 0.0,
          "title": "Version"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "profile_id",
        "version"
      ],
      "title": "ModelActivationInput",
      "description": "以配置版本为条件切换团队模型，空编号表示本地规则。"
    },
    "ModelCatalogInput": {
      "properties": {
        "address": {
          "type": "string",
          "maxLength": 2048,
          "title": "Address",
          "description": "模型接口基础地址",
          "default": ""
        },
        "api_key": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096,
              "format": "password",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "title": "Api Key",
          "description": "同地址留空复用已有密钥"
        },
        "version": {
          "type": "integer",
          "minimum": 0.0,
          "title": "Version",
          "description": "读取配置时的版本，环境变量初始版本为 0"
        },
        "credential_profile_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 36,
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "title": "Credential Profile Id",
          "description": "同地址可复用的配置编号"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "version"
      ],
      "title": "ModelCatalogInput",
      "description": "读取供应商模型列表，只接收对应地址的凭证和当前配置版本。"
    },
    "ModelCatalogRead": {
      "properties": {
        "models": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "title": "Models"
        }
      },
      "type": "object",
      "required": [
        "models"
      ],
      "title": "ModelCatalogRead",
      "description": "供应商公开给当前凭证的模型标识，实际对话兼容性通过试连确认。"
    },
